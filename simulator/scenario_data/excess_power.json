{
  "name": "excess_power",
  "title": "Excess power attack",
  "description": "Valid controller asks for 20 kW on a 7 kW session.",
  "session": {
    "session_id": "sess_excess_power",
    "vehicle_id": "Vehicle-01",
    "max_power_kw": 7.0,
    "max_current_a": 32.0
  },
  "steps": [
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "CONNECT",
      "expect": "ALLOW",
      "expect_rule": "ok"
    },
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "AUTHORIZE_SESSION",
      "expect": "ALLOW",
      "expect_rule": "ok"
    },
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "START_CHARGING",
      "expect": "ALLOW",
      "expect_rule": "ok"
    },
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "SET_POWER",
      "value": 20.0,
      "unit": "kW",
      "expect": "BLOCK",
      "expect_rule": "policy.power_limit"
    }
  ]
}

