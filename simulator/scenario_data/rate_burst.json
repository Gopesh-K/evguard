{
  "name": "rate_burst",
  "title": "Rate limit exceeded",
  "description": "Controller attempts to send commands in excess of the 5 commands per 10 second rate limit window.",
  "session": {
    "session_id": "sess_rate_burst",
    "vehicle_id": "Vehicle-01",
    "max_power_kw": 7.0,
    "max_current_a": 32.0
  },
  "steps": [
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "CONNECT",
      "expect": "ALLOW",
      "expect_rule": "ok"
    },
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "AUTHORIZE_SESSION",
      "expect": "ALLOW",
      "expect_rule": "ok"
    },
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "START_CHARGING",
      "expect": "ALLOW",
      "expect_rule": "ok"
    },
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "SET_POWER",
      "value": 5.0,
      "unit": "kW",
      "expect": "ALLOW",
      "expect_rule": "ok"
    },
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "SET_POWER",
      "value": 5.0,
      "unit": "kW",
      "expect": "ALLOW",
      "expect_rule": "ok"
    },
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "SET_POWER",
      "value": 5.0,
      "unit": "kW",
      "expect": "BLOCK",
      "expect_rule": "sequence.rate_exceeded"
    },
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "SET_POWER",
      "value": 5.0,
      "unit": "kW",
      "expect": "BLOCK",
      "expect_rule": "sequence.rate_exceeded"
    },
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "SET_POWER",
      "value": 5.0,
      "unit": "kW",
      "expect": "BLOCK",
      "expect_rule": "sequence.rate_exceeded"
    },
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "SET_POWER",
      "value": 5.0,
      "unit": "kW",
      "expect": "BLOCK",
      "expect_rule": "sequence.rate_exceeded"
    },
    {
      "source_id": "controller_A",
      "auth_token": "demo-token-controller-A",
      "command_type": "SET_POWER",
      "value": 5.0,
      "unit": "kW",
      "expect": "BLOCK",
      "expect_rule": "sequence.rate_exceeded"
    }
  ]
}

